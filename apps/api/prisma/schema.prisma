// Puente — data model. See docs/SPEC.md §3 and docs/DECISIONS.md.
// Ids are generated by the app with a readable prefix (src/lib/ids.ts), so no @default on @id.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id                       String          @id // biz_
  slug                     String          @unique
  name                     String
  kind                     String
  botName                  String
  voice                    String          @default("tu") // "tu" | "vos": how the assistant addresses customers
  llmProvider              String          @default("default") // "default" (server key) | "claude" | "gemini"
  llmApiKeySealed          String? // own AI key, AES-256-GCM under SECRETS_KEY; never returned by the API
  llmApiKeyLast4           String? // shown in the panel to recognize the saved key
  brandColor               String          @default("#1F5FBF")
  whatsappNumber           String // digits only, with country code
  /// Handoffs outside opening hours go here; null = whatsappNumber at all hours.
  offHoursWhatsappNumber   String?
  notifyEmail              String
  timezone                 String          @default("America/Asuncion")
  hours                    Json // { days: number[] (0=Sunday), from: "08:00", to: "17:30" }
  offHoursMessage          String
  greeting                 String
  suggestions              String[]        @default([])
  sensitiveTopics          String[]
  allowedDomains           String[]
  maxMessagesPerConv       Int             @default(20)
  /// Conversations per month in the commercial plan; null = no cap. Set by the operator
  /// (scripts/set-quota.ts), never from the panel. Over the cap the assistant keeps answering.
  monthlyConversationQuota Int?
  dailyMessageCap          Int             @default(2000)
  publicKey                String          @unique
  active                   Boolean         @default(true)
  createdAt                DateTime        @default(now())
  knowledge                KnowledgeItem[]
  conversations            Conversation[]
  handoffs                 Handoff[]
  users                    User[]
  avatar                   BusinessAvatar?
  usageMonths              UsageMonth[]
}

/// Assistant picture shown in the widget header (kept apart so chat queries never load it).
model BusinessAvatar {
  businessId String   @id
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  mimeType   String // image/png | image/jpeg | image/webp (validated by magic bytes)
  data       Bytes
  updatedAt  DateTime @updatedAt
}

/// Conversations counted per business and month (in its timezone). Holds no message content,
/// so retention keeps it: it is the billing record once the conversations are deleted.
model UsageMonth {
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  month          String // "2026-10"
  conversations  Int       @default(0)
  alert80SentAt  DateTime?
  alert100SentAt DateTime?
  updatedAt      DateTime  @updatedAt

  @@id([businessId, month])
}

model KnowledgeItem {
  id         String   @id // kb_
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  question   String
  answer     String
  position   Int
  updatedAt  DateTime @updatedAt

  @@index([businessId, position])
}

model Conversation {
  id               String             @id // conv_
  businessId       String
  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tokenHash        String // hash of the conversationToken held by the widget
  visitorId        String
  originDomain     String
  isPreview        Boolean            @default(false) // created from the panel's "Probar"
  status           ConversationStatus @default(OPEN)
  userMessageCount Int                @default(0)
  startedAt        DateTime           @default(now())
  lastMessageAt    DateTime           @default(now())
  messages         Message[]
  handoffs         Handoff[]

  @@index([businessId, startedAt])
  @@index([lastMessageAt])
}

enum ConversationStatus {
  OPEN
  HANDED_OFF
  CLOSED
}

model Message {
  id             String       @id // msg_
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  engine         String? // "llm" | "rules"
  inputTokens    Int?
  outputTokens   Int?
  latencyMs      Int?
  llmError       String? // "timeout" | "api_error" | "invalid_output" when the LLM failed
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Handoff {
  id             String         @id // hof_
  code           String         @unique // DER-4821
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reason         HandoffReason
  summary        String // for the team
  waMessage      String // what the customer sends over WhatsApp
  contactName    String?
  contactPhone   String?
  status         HandoffStatus  @default(PENDING)
  openedInHours  Boolean
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?
  events         HandoffEvent[]

  @@index([businessId, status, createdAt])
  @@index([conversationId, status])
}

enum HandoffReason {
  EXPLICIT_REQUEST
  NO_INFORMATION
  SENSITIVE_TOPIC
  FRUSTRATION
  REPETITION
  LIMIT
  TECHNICAL_FAILURE
}

enum HandoffStatus {
  PENDING
  RESOLVED
}

model HandoffEvent {
  id        String   @id // hev_
  handoffId String
  handoff   Handoff  @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  type      String // created | updated | whatsapp_opened | contact_requested | resolved | reopened | email_sent
  actor     String // "system" | "customer" | userId
  createdAt DateTime @default(now())

  @@index([handoffId, createdAt])
}

model User {
  id               String    @id // usr_
  businessId       String
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email            String    @unique
  passwordHash     String // argon2id
  role             UserRole  @default(AGENT)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  sessions         Session[]
}

enum UserRole {
  ADMIN
  AGENT
}

model Session {
  id        String   @id // ses_
  tokenHash String   @unique // hash of the httpOnly cookie token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
