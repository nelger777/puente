# Copia este archivo a deploy/.env en el servidor y completa cada valor.
# Genera secretos con:  openssl rand -hex 32

# --- Versión ---
# "latest" o el SHA de un commit (git log --format=%H) para fijar / volver atrás.
PUENTE_VERSION=latest

# --- Dominio y red ---
PUBLIC_URL=https://puente.tudominio.com
# Servidor compartido: otro proxy (p. ej. el Caddy del sistema) tiene 80/443 y reenvía el
# subdominio a 127.0.0.1:8090. Puente escucha solo en local y no emite certificados.
SITE_ADDRESS=:80
HTTP_BIND=127.0.0.1:8090
HTTPS_BIND=127.0.0.1:8453
# Servidor dedicado a Puente (Caddy de Puente con HTTPS automático):
#   SITE_ADDRESS=puente.tudominio.com
#   HTTP_BIND=80
#   HTTPS_BIND=443

# --- Base de datos ---
POSTGRES_PASSWORD=

# --- IA ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# --- Sesiones del panel (mínimo 32 caracteres aleatorios) ---
SESSION_SECRET=

# --- Correo saliente (proveedor SMTP: Brevo, Amazon SES, Resend, Mailgun, etc.) ---
# Formato: smtps://USUARIO:CLAVE@smtp.proveedor.com:465  (codifica caracteres especiales)
SMTP_URL=
MAIL_FROM="Puente <avisos@tudominio.com>"
# Quien opera la plataforma: alerta si la IA falla más del 5 % en una hora
ALERT_EMAIL=

# --- Datos ---
RETENTION_DAYS=90

# --- Primer negocio (solo para `docker compose exec api node dist/seed.js`) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
