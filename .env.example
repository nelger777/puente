# Base de datos (docker compose expone postgres en localhost:5433)
DATABASE_URL=postgresql://puente:puente@localhost:5433/puente
# Base separada para las pruebas (la crea docker/postgres/init.sql)
TEST_DATABASE_URL=postgresql://puente:puente@localhost:5433/puente_test
# Base de las pruebas e2e del widget (Playwright)
E2E_DATABASE_URL=postgresql://puente:puente@localhost:5433/puente_e2e

# IA (solo la API la usa)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_MS=15000
# Claves de IA por negocio (panel → Motor de IA); vacío = desactivado. openssl rand -hex 32
SECRETS_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Precios en USD por millón de tokens para el costo estimado (Claude Haiku 4.5)
LLM_PRICE_INPUT_PER_MTOK=1
LLM_PRICE_OUTPUT_PER_MTOK=5

# Correo (mailpit en desarrollo: http://localhost:8026)
SMTP_URL=smtp://localhost:1026
# API de mailpit, solo para las pruebas que verifican el envío
MAILPIT_URL=http://localhost:8026
MAIL_FROM="Puente <no-reply@puente.local>"

# Sesiones del panel (mínimo 32 caracteres aleatorios)
SESSION_SECRET=change-me-to-a-long-random-string-32chars

# URLs públicas
PUBLIC_API_URL=http://localhost:3000
WIDGET_CDN_URL=http://localhost:5173
PANEL_URL=http://localhost:5174

RETENTION_DAYS=90
# Correo de quien opera la plataforma: alerta si la IA falla más del 5 % en una hora
ALERT_EMAIL=
NODE_ENV=development
PORT=3000
# 127.0.0.1 en desarrollo; 0.0.0.0 dentro de contenedores
HOST=127.0.0.1
# true detrás de un proxy inverso (IP real del cliente para los límites)
TRUST_PROXY=false
